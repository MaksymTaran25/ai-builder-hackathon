LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=

# Future MongoDB Configuration (Read-Only Opportunity Store)
# When the team finalizes the MongoDB cluster, provide connection details below.
MONGODB_URI=
MONGODB_DATABASE=federal_opportunities
MONGODB_COLLECTION=opportunities
